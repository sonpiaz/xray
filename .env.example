# XRay configuration — copy to .env and fill in.

# --- Kyma API (primary intelligence backend) ---
# Get a key: curl -X POST https://kymaapi.com/v1/auth/register -d '{"email":"you@..."}'
KYMA_API_URL=https://kymaapi.com/v1
KYMA_API_KEY=

# Default model. Long-context defaults to gemini-2.5-flash (1M ctx) which handles big threads well.
# Other options: qwen-3.6-plus (best overall), deepseek-v4-flash (cheap), kimi-k2.6 (agentic).
XRAY_MODEL=gemini-2.5-flash

# --- Cache ---
# Where SQLite cache and Playwright storageState live. Default: ~/.xray
XRAY_HOME=
# Seconds. 0 = never expire. Default 86400 (24h).
XRAY_CACHE_TTL=86400

# --- Fetcher ---
# Default fetch mode. 'auto' tries anonymous first, falls back to cookies; 'anon' forces no-auth;
# 'auth' requires storageState (must run `xray auth` first).
XRAY_FETCH_MODE=auto
XRAY_FETCH_TIMEOUT_MS=30000
XRAY_HEADLESS=true

# --- Logging ---
# debug | info | warn | error
XRAY_LOG_LEVEL=info
